# BingoScape Next Environment Configuration
# =============================================
# Create a copy of this file named ".env" and populate with your values
# This file is committed to version control - do not add secrets here

# When adding new environment variables, update the schema in "/src/env.js"

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

# PostgreSQL connection string
# Development: Use local PostgreSQL instance
# Production: point at the PostgreSQL instance the app should use
DATABASE_URL="postgresql://postgres:password@localhost:5432/bingoscape"

# ==============================================
# AUTH CONFIGURATION (Better Auth; the NEXTAUTH_ names are kept)
# ==============================================

# Auth secret key - CRITICAL: Must be secure in production
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secure-secret-key-here"

# Application URL - must match your deployment URL
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# ==============================================
# DISCORD OAUTH CONFIGURATION
# ==============================================

# Discord application credentials
# Create at: https://discord.com/developers/applications
# Set redirect URL to: {NEXTAUTH_URL}/api/auth/callback/discord

DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# ==============================================
# GITHUB OAUTH CONFIGURATION (Optional)
# ==============================================

# GitHub OAuth App credentials
# Create at: https://github.com/settings/developers
# Click "New OAuth App" and configure:
#   - Application name: BingoScape Next
#   - Homepage URL: {NEXTAUTH_URL}
#   - Authorization callback URL: {NEXTAUTH_URL}/api/auth/callback/github
# Leave these commented out if you don't want GitHub authentication

# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"

# ==============================================
# GOOGLE OAUTH CONFIGURATION (Optional)
# ==============================================

# Google Cloud Console OAuth credentials
# Create at: https://console.cloud.google.com/
# Steps:
#   1. Create a new project or select existing
#   2. Enable "Google+ API" (or "Google Identity Services")
#   3. Go to Credentials > Create Credentials > OAuth client ID
#   4. Set Application type: Web application
#   5. Add Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
# Leave these commented out if you don't want Google authentication

# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================

# Super admin email addresses (comma-separated)
# These users have full administrative access to the application.
# Matching is case-insensitive and whitespace-trimmed, and is checked against the
# email stored in the database (not the session). There is NO fallback: leave this
# empty and nobody is a super admin. docker-compose.yml no longer defaults it to
# admin@example.com, so set it explicitly in production.
# Replace the placeholder below with real addresses you control.
SUPER_ADMIN_EMAILS="admin@example.com"

# Read policy for Event data (RBAC epic #183, optional)
#   enforce (default): who may read an Event's Boards, Tiles, statistics and
#                      Teams follows the membership and visibility rules.
#   relaxed:           escape hatch while the policy beds in. Non-members are
#                      read like participants for Boards, Tiles, statistics and
#                      Teams (what was possible before the policy). Hidden and
#                      Blind Tiles, battleship privacy, managers-only data and
#                      secrets (codephrase, tracker verification code) stay
#                      protected.
# Read on every request: change it in the server .env and restart the app
# container, no rebuild or new image needed. Unknown values mean "enforce".
# RBAC_READ_POLICY="enforce"

# Content-Security-Policy mode (RBAC 7/8, optional)
#   report-only (default): the browser logs violations in its console and blocks
#                          nothing. Watch the console on the main pages first.
#   enforce:               violations are blocked.
#   off:                   no CSP header.
# Read on every request: change it in the server .env and restart the app
# container. X-Content-Type-Options and Referrer-Policy are always sent.
# CSP_MODE="report-only"

# ==============================================
# OSRS WIKI GRAND EXCHANGE API
# ==============================================

# Contact (Discord handle) for the OSRS Wiki API User-Agent header (required)
# The Wiki API requires identification in User-Agent for rate limiting
# Format will be: "Bingoscape/1.0.0 - your_discord_handle"
# More info: https://oldschool.runescape.wiki/w/RuneScape:Real-time_Prices
OSRS_WIKI_CONTACT_EMAIL="your_discord_handle"

# Serve OSRS Wiki images from the image cache (optional)
#   true (default): tiles, goals, templates and notifications load wiki images
#                   from /api/osrs-image/... instead of from the wiki.
#   false:          images load from the wiki again. This is the rollback of the
#                   render rewrite; stored values are wiki URLs either way. The
#                   CSP (img-src https:) and next.config remotePatterns already
#                   allow the wiki, so nothing else has to change.
# Read on every request: change it in the server .env and restart the app
# container, no rebuild needed.
# OSRS_IMAGE_PROXY="true"

# Directory of the OSRS Wiki image cache (optional)
# Wiki images are fetched once and then served from here. In Docker this is the
# mounted volume /app/data/osrs-images (set by docker-compose.yml); for local
# development the default is ./.data/osrs-images. The cache is regenerable and
# not backed up; `npm run images:warm` optionally pre-fills it.
# OSRS_IMAGE_CACHE_DIR="./.data/osrs-images"

# ==============================================
# WISE OLD MAN (Optional)
# ==============================================

# Optional Wise Old Man API key, passed to the Wise Old Man client for higher
# rate limits. Leave commented out to use the anonymous limits.
# WISEOLDMAN_API_KEY="your-wise-old-man-api-key"

# ==============================================
# OPTIONAL: DEVELOPMENT SETTINGS
# ==============================================

# Node environment (automatically set by deployment platforms)
# NODE_ENV="development"

# Skip environment validation (useful for Docker builds)
# SKIP_ENV_VALIDATION="true"

# ==============================================
# SETUP INSTRUCTIONS
# ==============================================

# 1. Copy this file: cp .env.example .env
# 2. Set up PostgreSQL database (or use Docker: docker-compose up -d)
# 3. Create Discord application at https://discord.com/developers/applications
# 4. Generate NEXTAUTH_SECRET: openssl rand -base64 32
# 5. (Optional) Set up GitHub OAuth App at https://github.com/settings/developers
# 6. (Optional) Set up Google OAuth at https://console.cloud.google.com/
# 7. Run database migrations: npm run db:migrate
# 8. Start development server: npm run dev

# NOTE: GitHub and Google authentication are optional.
# Discord authentication is required by default.
# To enable GitHub/Google, uncomment their respective variables and add credentials.

# For production deployment, ensure all secrets are properly secured!
